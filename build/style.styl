  if stretch-video {
    video {
      position: static !important;
      width: 100% !important;
      height: 100vh !important;
      transform: scaleX(1) !important;
      object-fit: fill !important;
    }

    #player-full-bleed-container.ytd-watch-flexy {
      position: unset;
    }
  }

  if hide-buttons {
